# GIAI ĐOẠN 1: Xây dựng (build) ứng dụng React
# ---------------------------------------------------
# Sử dụng một image Node.js phiên bản 20-alpine làm nền tảng.
# 'alpine' là phiên bản rất nhẹ, giúp image cuối cùng nhỏ hơn.
FROM node:20-alpine AS builder

# Thiết lập thư mục làm việc bên trong container là /app
WORKDIR /app

# Sao chép file package.json và package-lock.json từ thư mục 'client' của bạn vào container.
# Việc này giúp tận dụng bộ nhớ đệm (cache) của Docker. Nếu các file này không đổi,
# Docker sẽ không cần chạy lại lệnh 'npm ci' ở bước tiếp theo.
COPY client/package*.json ./client/

# Di chuyển vào thư mục /app/client bên trong container
WORKDIR /app/client
# Chạy lệnh 'npm ci' để cài đặt các thư viện một cách chính xác từ file package-lock.json.
RUN npm ci

# Quay lại thư mục /app và sao chép toàn bộ mã nguồn của thư mục 'client' vào container.
WORKDIR /app
COPY client/ ./client/

# Di chuyển vào lại thư mục client để thực hiện build
WORKDIR /app/client
# Chạy script "build" đã được định nghĩa trong package.json của bạn.
# Lệnh này sẽ tạo ra một thư mục 'dist' chứa các file tĩnh đã được tối ưu hóa.
RUN npm run build


# GIAI ĐOẠN 2: Phục vụ (serve) ứng dụng bằng Nginx
# ----------------------------------------------------
# Sử dụng một image Nginx chính thức, phiên bản alpine siêu nhẹ.
FROM nginx:1.27-alpine

# Sao chép file cấu hình Nginx mà bạn đã tạo (nginx.conf)
# vào thư mục cấu hình mặc định của Nginx bên trong container.
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Sao chép các file đã được build từ Giai đoạn 1 (từ thư mục /app/client/dist)
# vào thư mục mà Nginx dùng để phục vụ trang web (/usr/share/nginx/html).
COPY --from=builder /app/client/dist /usr/share/nginx/html

# Mở cổng 80 của container để cho phép các kết nối từ bên ngoài vào.
EXPOSE 80

# Lệnh mặc định để khởi động Nginx khi container được chạy.
# 'daemon off;' giữ cho Nginx chạy ở tiền cảnh, điều này là cần thiết cho Docker.
CMD ["nginx", "-g", "daemon off;"]

